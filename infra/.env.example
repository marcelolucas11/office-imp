# office-imp — variáveis de produção. O install.sh gera este arquivo em /opt/office-imp/.env
# com segredos aleatórios; edite só se souber o que está fazendo.

# Endereços
DOMAIN=office-impera.imperaservices.com
RTC_DOMAIN=rtc-office-impera.imperaservices.com
PUBLIC_URL=https://office-impera.imperaservices.com
LIVEKIT_PUBLIC_URL=wss://rtc-office-impera.imperaservices.com
PUBLIC_IP=203.0.113.10
INSTALL_DIR=/opt/office-imp

# Versão das imagens (trocada pelo botão "Atualizar servidor" e pelo update.sh)
OFFICE_IMP_VERSION=1.0.0

# Onde o app e o LiveKit ficam disponíveis para o proxy reverso do host
BIND_ADDR=127.0.0.1
APP_PORT=3080
LIVEKIT_PORT=7880

# Segredos (gere com: openssl rand -hex 32)
POSTGRES_PASSWORD=
APP_SECRET=
APP_ENCRYPTION_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
UPDATER_TOKEN=
SETUP_TOKEN=

# Transcrição (auto escolhe small/base/tiny pela memória livre)
WHISPER_MODEL=auto
WHISPER_THREADS=2
WHISPER_LANGUAGE=pt

# Opcional: resumo das reuniões por IA (endpoint compatível com OpenAI/Ollama)
SUMMARY_LLM_URL=
SUMMARY_LLM_MODEL=
SUMMARY_LLM_KEY=

# Opcional: Google Calendar (também dá para preencher pelo Painel do ADM → Configurações)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Só para o perfil "caddy" (HTTPS automático)
ACME_EMAIL=
